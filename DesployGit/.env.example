# ==============================================================================
# DESPLOYGIT ACCOUNT HUB - CẤU HÌNH BIẾN MÔI TRƯỜNG
# ==============================================================================

# Cổng lắng nghe của Server (mặc định 8080)
PORT=8080

# Mã bí mật xác thực API dành cho Client gửi acc (Header: X-API-Key)
API_SECRET_KEY=shardx-secret-api-key-2026-very-secure

# Tài khoản đăng nhập trang quản trị Web Dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminSecure@2026!Pass

# Khóa bảo mật ký Session JWT cho Admin Dashboard
JWT_SECRET=super-secure-jwt-secret-key-shardx-hub-2026

# Đường dẫn lưu trữ Database SQLite (mặc định lưu tại ./data/accounts.db)
DATABASE_PATH=./data/accounts.db

# Môi trường chạy (production / development)
NODE_ENV=production
