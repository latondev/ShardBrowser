# Copy this file to .env and replace every placeholder locally.
# Never commit .env or paste its values into chat.
OPENAI_API_KEY=your-model-api-key
GITHUB_EMAIL=your-github-email
GITHUB_PASSWORD=your-github-password
GITHUB_TOTP_SECRET=your-base32-totp-secret

# Optional
BROWSER_USE_MODEL=gpt-4.1-mini
RAPIDAPI_API_URL=https://rapidapi.com/canvabouys/api/free-gmail-api
