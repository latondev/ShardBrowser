# Browser Use Cloud API key, starting with bu_. Required by npm run start.
BROWSER_USE_API_KEY=bu_replace_me

# GitHub credentials. Never commit the real .env file.
GITHUB_LOGIN=your-github-email-or-username
GITHUB_PASSWORD=replace_me
GITHUB_TOTP_SECRET=replace_with_base32_secret

# Use "site" to reproduce the original 2fa.co.com step, or "local" to
# calculate the TOTP in this process without sending the secret to a website.
TOTP_SOURCE=local

# The GitHub username shown on the OAuth approval screen.
GITHUB_EXPECTED_USERNAME=your-github-username

SEEKAI_API_KEY_NAME=Auto_API_Key_01
BROWSER_PROXY_COUNTRY=us

# Local Chrome runner options.
HEADLESS=0
KEEP_BROWSER=0
LOCAL_PROFILE_DIR=.local-browser-profile
